[Desktop Entry]
Type=Application
Name=WinUSB SteamOS
GenericName=Bootable USB Creator
GenericName[de]=Bootfähige USB-Sticks erstellen
Comment=Create bootable USB sticks from Windows ISOs, SteamOS recovery images and Linux ISOs
Comment[de]=Bootfähige USB-Sticks aus Windows-ISOs, SteamOS-Recovery-Images und Linux-ISOs erstellen
Exec=winusb-steamos %f
Icon=winusb-steamos
Terminal=false
Categories=Utility;
MimeType=application/x-cd-image;application/x-iso9660-image;
Keywords=windows;usb;iso;boot;installer;woeusb;rufus;
