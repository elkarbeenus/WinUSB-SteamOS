#!/bin/bash
# WinUSB-SteamOS AppRun
HERE="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
export WINUSB_APPDIR="$HERE"
export WINUSB_ICON="$HERE/winusb-steamos.png"
PY="$HERE/opt/python/bin/python3"
APP="$HERE/usr/share/winusb"

# keep the host's Python environment out of our bundled interpreter
unset PYTHONHOME PYTHONPATH PYTHONSTARTUP
export PYTHONNOUSERSITE=1
export PYTHONDONTWRITEBYTECODE=1

case "$1" in
    --worker|--cli)
        exec "$PY" -s -E "$APP/winusb_worker.py" "$@"
        ;;
    --version)
        "$PY" -s -E -c 'import json,sys; d=json.load(open(sys.argv[1])); print("WinUSB-SteamOS %s (build %s %s)" % (d.get("version"), d.get("date"), d.get("commit")))' "$APP/build_info.json" 2>/dev/null \
            || echo "WinUSB-SteamOS dev"
        exit 0
        ;;
    -h|--help)
        cat <<EOF
WinUSB-SteamOS – create bootable USB sticks (Windows ISO, SteamOS recovery image, Linux ISO)

  $(basename "${APPIMAGE:-WinUSB-SteamOS.AppImage}")                 GUI
  $(basename "${APPIMAGE:-WinUSB-SteamOS.AppImage}") <file>          GUI with the file preselected

Text mode (as root):
  sudo ./WinUSB-SteamOS-x86_64.AppImage --cli --iso Win11.iso --device /dev/sdX \\
       [--win11-bypass] [--local-account] [--yes] [--lang en|de]
  sudo ./WinUSB-SteamOS-x86_64.AppImage --cli --image steamdeck-repair.img.bz2 --device /dev/sdX
EOF
        exit 0
        ;;
esac

# Qt: no host plugins/themes leaking in, works on X11 and Wayland
unset QT_PLUGIN_PATH QT_QPA_PLATFORM_PLUGIN_PATH
if [ -z "$QT_QPA_PLATFORM" ]; then
    if [ -n "$DISPLAY" ]; then
        export QT_QPA_PLATFORM="xcb;wayland"
    elif [ -n "$WAYLAND_DISPLAY" ]; then
        export QT_QPA_PLATFORM="wayland;xcb"
    fi
fi
# xcb helper libs (+ matching libxkbcommon pair, must be the same version)
export LD_LIBRARY_PATH="${LD_LIBRARY_PATH:+$LD_LIBRARY_PATH:}$HERE/usr/lib/gui"
exec "$PY" -s -E "$APP/winusb_gui.py" "$@"
